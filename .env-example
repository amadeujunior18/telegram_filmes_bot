# --- CONFIGURAÇÕES DE API DO TELEGRAM ---
# Obtenha em https://my.telegram.org
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# --- CONFIGURAÇÕES DO BOT ---
# Nome do arquivo de sessão que será gerado (.session)
SESSION_NAME=ZumbiBot

# ID do Chat ou Canal que o bot deve monitorar para downloads
# Ex: -1001234567890
CHAT_ID=-1001234567890

# --- CONFIGURAÇÕES DE DISCO ---
# Caminho absoluto onde as pastas 'Filmes' e 'Series' serão criadas
DOWNLOAD_DIR=D:\Midia

# --- METADADOS (TMDb) ---
# Se True, enriquece os metadados com sinopse, gêneros e nome oficial.
# Se False, usa apenas a detecção local baseada no nome do arquivo/legenda.
ENABLE_TMDB=True

# API Key do TMDb para integração direta (mais rápido e confiável que o bot).
# Obtenha gratuitamente em: themoviedb.org → Settings → API → Developer
# Se vazia, usa o @tmdbinfobot como fallback.
TMDB_API_KEY=

# --- PERFORMANCE ---
# Número de conexões paralelas por arquivo de download. 
# Recomendado: 4 a 10. SSDs aguentam valores maiores (até 16).
WORKERS=10
